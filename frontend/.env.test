# Dummy values so contracts.ts's module-load validation passes under `npm test`.
# Not real deployments — testnet/mainnet use distinct values on purpose so
# tests can prove network selection actually changes what's targeted.
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://testnet.example.invalid/rpc
VITE_CONTRACT_ATOMIC_SWAP=TESTNET_ATOMIC_SWAP_CONTRACT_ID
VITE_CONTRACT_IP_REGISTRY=TESTNET_IP_REGISTRY_CONTRACT_ID
VITE_CONTRACT_ZK_VERIFIER=TESTNET_ZK_VERIFIER_CONTRACT_ID
VITE_CONTRACT_USDC=TESTNET_USDC_CONTRACT_ID

VITE_MAINNET_STELLAR_RPC_URL=https://mainnet.example.invalid/rpc
VITE_MAINNET_CONTRACT_ATOMIC_SWAP=MAINNET_ATOMIC_SWAP_CONTRACT_ID
VITE_MAINNET_CONTRACT_IP_REGISTRY=MAINNET_IP_REGISTRY_CONTRACT_ID
VITE_MAINNET_CONTRACT_ZK_VERIFIER=MAINNET_ZK_VERIFIER_CONTRACT_ID
VITE_MAINNET_CONTRACT_USDC=MAINNET_USDC_CONTRACT_ID
